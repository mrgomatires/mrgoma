[DATA BASE CONNECTION]

# Connection details used only on the server. Do not prefix them with
# NEXT_PUBLIC_ to avoid exposing them to the client.
SERVER_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
API_URL=

[LOGGING]
# Log level for the application logger
LOG_LEVEL=info


[PAYMENTS]
# Toggle to enable Stripe Checkout on the server. When not 'true', WhatsApp flow is used.
ENABLE_STRIPE_CHECKOUT=
# Secret API key from your Stripe dashboard (server-only)
STRIPE_SECRET_KEY=
# Publishable key for client-side Stripe SDK (if you later add it)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Currency for Stripe Checkout (e.g. usd, cop, eur)
NEXT_PUBLIC_STRIPE_CURRENCY=
# Client-side toggle to show correct CTA label. Should mirror ENABLE_STRIPE_CHECKOUT.
NEXT_PUBLIC_ENABLE_STRIPE=

# Optional tax rate used for UI estimation on checkout page (0 to disable)
NEXT_PUBLIC_TAX_RATE=

[APP]
# Public base URL used by server routes when constructing absolute URLs
NEXT_PUBLIC_BASE_URL=
# Canonical URL of the app — required by NextAuth in production for server-side fetches.
# In development this defaults to http://localhost:3000 automatically.
# In Vercel set this to your deployment URL (e.g. https://mrgoma.vercel.app)
NEXTAUTH_URL=
# Local production builds only (`npm run build && npm run start`). Auth.js
# refuses to sign in on a host it doesn't trust ("UntrustedHost"); `next dev`
# and Vercel trust theirs automatically, a local `next start` does not.
# Never set it in Vercel's environment variables. scripts/lab.mjs sets it for
# the servers perf:lab and a11y start. (058)
AUTH_TRUST_HOST=true
# WhatsApp number to receive orders (digits only, with country code). If not set, defaults to 573222202887.
WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=
N8N_WEBHOOK_URL=

[TESTING]
# When set to 'true' (or 1/yes/on), checkout operations will not write to the database.
# This prevents POST/UPDATE statements during tests while keeping the flow functional.
# Also respects TEST_MODE for compatibility if provided by the environment.
CHECKOUT_TEST_MODE=

[SEO / GOOGLE MERCHANT]
# Secret token that protects the Google Merchant Center product feed at
# /feed/google-merchant.xml. Server-only — NEVER prefix with NEXT_PUBLIC_.
# Paste the full tokenized URL (…/feed/google-merchant.xml?key=THIS) into the
# GMC admin as a scheduled fetch. Requests without the correct key get 403.
MERCHANT_FEED_TOKEN=

[AI ASSISTANT]
# Server-only API key for Anthropic Claude (used by the AI inventory assistant in the dashboard)
# Get it at: console.anthropic.com → API Keys → Create Key
# NEVER prefix with NEXT_PUBLIC_ — this must stay server-side only
ANTHROPIC_API_KEY=
# Set to 'true' to show the AI chat button in the dashboard. Any other value hides it.
NEXT_PUBLIC_AI_CHAT_ENABLED=true

{
  "name": "mrgoma-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "perf:budget": "node scripts/perf-budget.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force node_modules, .next, package-lock.json -ErrorAction SilentlyContinue\"",
    "reinstall": "npm run clean && npm install",
    "a11y": "node scripts/a11y-check.mjs",
    "perf:lab": "node scripts/perf-lab.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/postcss": "4.1.17",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "1.6.1",
    "dotenv": "17.2.3",
    "mssql": "12.2.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.71.1",
    "stripe": "20.0.0",
    "three": "^0.185.0",
    "winston": "3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mssql": "9.1.8",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.0",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "@vitest/coverage-v8": "^4.1.9",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "9.39.2",
    "eslint-config-next": "16.0.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lighthouse": "13.6.0",
    "postcss": "^8.5.25",
    "prettier": "3.7.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
